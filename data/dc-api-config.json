            "format": "dc+sd-jwt",
            "meta": { "vct_values": ["https://webuildconsortium.eu/sca/sca-card-dpc/1.0"] },
            "claims": [
              { "path": ["credential_id"] },
              { "path": ["network"] },
              { "path": ["card_id"] }
            ]
