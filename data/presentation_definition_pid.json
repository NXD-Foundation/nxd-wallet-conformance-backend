{
  "id": "d49ee616-0e8d-4698-aff5-2a8a2362652d",
  "name": "id-card-proof",
  "format": {
    "dc+sd-jwt": {
      "alg": ["ES256", "ES384"]
    }
  },
  "input_descriptors": [
    {
      "id": "abd4acb1-1dcb-41ad-8596-ceb1401a69c7",
      "format": {
        "dc+sd-jwt": {
          "alg": ["ES256", "ES384"]
        }
      },
      "constraints": {
        "fields": [
          {
            "path": ["$.given_name", "$.credentialSubject.given_name", "$.vc.credentialSubject.given_name"]
          },
          {
            "path": ["$.family_name", "$.credentialSubject.family_name", "$.vc.credentialSubject.family_name"]
          },
          {
            "path": ["$.birthdate", "$.credentialSubject.birthdate", "$.vc.credentialSubject.birthdate"]
          },
          {
            "path": ["$.nationalities", "$.credentialSubject.nationalities", "$.vc.credentialSubject.nationalities"]
          },
          {
            "path": ["$.place_of_birth", "$.credentialSubject.place_of_birth", "$.vc.credentialSubject.place_of_birth"]
          },
          {
            "path": ["$.picture", "$.credentialSubject.picture", "$.vc.credentialSubject.picture"]
          },
          {
            "path": ["$.date_of_issuance", "$.credentialSubject.date_of_issuance", "$.vc.credentialSubject.date_of_issuance"]
          },
          {
            "path": ["$.date_of_expiry", "$.credentialSubject.date_of_expiry", "$.vc.credentialSubject.date_of_expiry"]
          },
          {
            "path": ["$.issuing_authority", "$.credentialSubject.issuing_authority", "$.vc.credentialSubject.issuing_authority"]
          },
          {
            "path": ["$.issuing_country", "$.credentialSubject.issuing_country", "$.vc.credentialSubject.issuing_country"]
          },
          {
            "path": ["$.vct", "$.vc.vct"],
            "filter": {
              "type": "string",
              "const": "urn:eu.europa.ec.eudi:pid:1"
            },
            "purpose": "To request the Person Identification Data credential."
          }
        ]
      }
    }
  ]
}
