          "path": [
            "given_name"
          ]
        },
        {
          "path": [
            "family_name"
          ]
        },
        {
          "path": [
            "birthdate"
          ]
        },
        {
          "path": [
            "place_of_birth"
          ]
        },
        {
          "path": [
            "nationalities"
          ]
        },
        {
          "path": [
            "issuing_authority"
          ]
        },
        {
          "path": [
            "issuing_country"
          ]
        }
      ]
    }
  ]
